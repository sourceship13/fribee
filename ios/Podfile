def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

# Configure react-native-permissions
setup_permissions([
  'Contacts',
  'LocationWhenInUse'
])

platform :ios, '15.1'
prepare_react_native_project!

# Keep New Architecture enabled (required by Reanimated)
ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# React Native Maps dependencies
rn_maps_path = '../node_modules/react-native-maps'
pod 'react-native-maps/Google', :path => rn_maps_path

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

def shared_pods
  config = use_native_modules!
  
  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :fabric_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )
end

target 'fribee-staging' do
  shared_pods
end

target 'fribee-prod' do
  shared_pods
end
post_install do |installer|
  react_native_post_install(
    installer,
    "../node_modules/react-native",
    :mac_catalyst_enabled => false
  )
  
  # Workaround: newer Clang/Xcode betas have a broken FMT_USE_CONSTEVAL detection
  # that makes fmt::format_to(FMT_STRING(...)) fail with "call to consteval
  # function is not a constant expression" in format-inl.h. Force fmt to skip
  # its consteval-based compile-time format string checks.
  fmt_base_header = File.join(installer.sandbox.root, 'fmt/include/fmt/base.h')
  if File.exist?(fmt_base_header)
    contents = File.read(fmt_base_header)
    patched = contents.sub(
      "#if FMT_USE_CONSTEVAL\n#  define FMT_CONSTEVAL consteval",
      "#if 0  // patched: FMT_USE_CONSTEVAL disabled, see Podfile post_install\n#  define FMT_CONSTEVAL consteval"
    )
    if patched != contents
      File.chmod(0644, fmt_base_header) # CocoaPods installs pod sources as read-only
      File.write(fmt_base_header, patched)
    end
  end
  
  # Fix duplicate React-Core privacy bundle issue (React Native 0.81+)
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.native_targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'NO'
      end
    end
    aggregate_target.user_project.save
  end
  
  # Basic build settings
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
    config.build_settings['DISABLE_MANUAL_TARGET_ORDER_BUILD_WARNING'] = 'YES'
  end
  
  # Remove duplicate React-Core.common-React-Core_privacy target to fix build conflict
  duplicate_target = installer.pods_project.targets.find { |t| t.name == 'React-Core.common-React-Core_privacy' }
  if duplicate_target
    installer.pods_project.targets.delete(duplicate_target)
    duplicate_target.remove_from_project
  end
  
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['DEAD_CODE_STRIPPING'] = 'YES'
      
      # Exclude x86_64 for simulator builds to fix Xcode 26 beta issues
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'x86_64'
      
      # Force all pods (including resource bundle targets) to match the app's minimum deployment target
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.1
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
      end
      
      if target.respond_to?(:product_type) && target.product_type == "com.apple.product-type.bundle"
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
        config.build_settings['CODE_SIGN_IDENTITY'] = ''
      end
      
      if target.name.include?('React-Core') && target.name.include?('privacy')
        config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      end
    end
  end
end